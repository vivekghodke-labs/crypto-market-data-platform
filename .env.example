# ─── GCP Configuration ────────────────────────────────────────────────────────
GCP_PROJECT_ID=vg-ind-2026
GCP_REGION=us-central1

# ─── Pub/Sub ──────────────────────────────────────────────────────────────────
PUBSUB_TOPIC_RAW_TRADES=btc-raw-trades
PUBSUB_TOPIC_DEAD_LETTER=btc-dead-letter

# ─── Binance WebSocket ────────────────────────────────────────────────────────
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@trade
ASSET_SYMBOL=BTCUSDT

# ─── Local Dev Only (Pub/Sub Emulator) ────────────────────────────────────────
# Uncomment when running via docker-compose locally
# PUBSUB_EMULATOR_HOST=pubsub-emulator:8085

# ─── Application ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
PORT=8080
###############################################################################
# Custom Apache Airflow image for the Crypto Market Data Platform.
#
# Extends the official Airflow 2.10.3 image with:
#   - dbt-bigquery (for DbtRunOperator and DbtTestOperator)
#   - apache-airflow-providers-google (BigQueryHook, GCS operators)
#   - apache-airflow-providers-http (HttpSensor for ingestor health check)
#
# Build target: linux/amd64 (required for GCP compatibility)
# Base: apache/airflow:2.10.3-python3.12
#
# Non-root: Airflow official image already runs as user 'airflow' (UID 50000).
# We inherit this — no USER directive needed.
###############################################################################

FROM apache/airflow:2.10.3-python3.12

# Switch to root only for system dependency installation
USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Switch back to airflow user for pip installs
USER airflow

# Copy and install Python dependencies
COPY requirements.airflow.txt /requirements.airflow.txt
RUN pip install --no-cache-dir -r /requirements.airflow.txt

# Copy dbt project into the image so DbtRunOperator can find it
COPY --chown=airflow:root ../dbt /opt/airflow/dbt

# Copy DAGs, plugins explicitly (also mounted via volume in docker-compose
# for hot-reload during development)
COPY --chown=airflow:root dags/ /opt/airflow/dags/
COPY --chown=airflow:root plugins/ /opt/airflow/plugins/